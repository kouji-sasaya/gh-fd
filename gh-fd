#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

usage() {
  cat <<USAGE
Usage: gh fd <command>

Commands:
  setup        Install fd and make the 'fd' command available
  cleanup      Remove what 'setup' installed
  find-is-fd   Report whether 'fd' is available and which binary provides it
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  setup)      exec bash "$DIR/commands/setup.sh" "$@" ;;
  cleanup)    exec bash "$DIR/commands/cleanup.sh" "$@" ;;
  find-is-fd) exec bash "$DIR/commands/find-is-fd" "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
